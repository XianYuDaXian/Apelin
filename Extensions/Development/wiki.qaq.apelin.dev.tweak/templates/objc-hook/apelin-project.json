{
  "schemaVersion": 1,
  "projectID": "{{projectID}}",
  "kind": "tweak",
  "template": {
    "extensionID": "{{templateExtensionID}}",
    "templateID": "{{templateID}}",
    "version": "{{templateVersion}}",
    "digest": "{{templateDigest}}"
  },
  "environment": {
    "toolchain": { "id": "{{toolchainID}}", "digest": "{{toolchainDigest}}" },
    "sdk": { "id": "{{sdkID}}", "digest": "{{sdkDigest}}" }
  },
  "language": "objc",
  "deploymentTarget": "{{deploymentTarget}}",
  "architectures": {{architectures}},
  "configurations": {
    "Debug": { "optimization": "0", "debugInfo": true, "defines": { "DEBUG": "1" } },
    "Release": { "optimization": "2", "debugInfo": true }
  },
  "products": [
    {
      "id": "tweak",
      "type": "dylib",
      "name": "{{productName}}",
      "sources": ["Sources/*.m"],
      "headerSearchPaths": ["Sources"],
      "objcARC": true,
      "frameworks": ["Foundation", "UIKit"],
      "libraries": ["substrate"],
      "extensionSupport": [{ "extension": "wiki.qaq.apelin.dev.tweak", "component": "substrate" }]
    }
  ],
  "build": {
    "steps": [
      { "type": "compile", "product": "tweak" },
      { "type": "link", "product": "tweak" },
      { "type": "lipo", "product": "tweak" },
      { "type": "dsym", "product": "tweak" },
      { "type": "strip", "product": "tweak", "style": "non-global" },
      { "type": "sign", "product": "tweak", "identity": "adhoc" }
    ]
  },
  "package": {
    "id": "{{packageID}}",
    "name": "{{displayName}}",
    "version": "0.0.1",
    "description": "{{summary}}",
    "icon": "https://owngoal-dev.github.io/Apelin/icons/wiki.qaq.apelin.dev.tweak.png",
    "author": "{{author}}",
    "section": "Tweaks",
    "depends": ["mobilesubstrate"],
    "layout": [
      { "path": "/Library/MobileSubstrate/DynamicLibraries/{{productName}}.dylib", "product": "tweak" }
    ],
    "tweakFilter": { "dylib": "tweak", "bundles": {{filterBundles}} }
  }
}
